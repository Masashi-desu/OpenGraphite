{
  "version": "0.1.0",
  "types": [
    "page",
    "frame",
    "text",
    "button",
    "image",
    "icon"
  ],
  "layouts": [
    "vertical",
    "horizontal",
    "absolute"
  ],
  "roles": [
    "component-placement"
  ],
  "editableAttributes": [
    "data-og-type",
    "data-og-layout",
    "data-og-role",
    "data-og-component",
    "data-og-component-kind",
    "data-og-variant",
    "data-og-slot",
    "data-og-part",
    "data-og-text-source",
    "data-og-lang-source",
    "data-og-lang-field",
    "data-og-dir-source",
    "data-og-dir-field",
    "data-og-source-component-internal-id",
    "data-og-source-node-internal-id",
    "data-og-placement-mode",
    "data-og-state-hidden",
    "data-og-state-visible",
    "data-og-icon-library",
    "data-og-icon-name",
    "data-og-icon-source",
    "data-i18n-key",
    "data-og-text-variant-eng",
    "data-og-hidden",
    "data-og-locked"
  ],
  "runtimeAttributes": [
    "data-og-selected",
    "data-og-editing",
    "data-og-expanded",
    "data-og-generated",
    "data-og-component-error",
    "data-og-host-id",
    "data-og-instance-source",
    "data-og-source-component",
    "data-og-source-instance",
    "data-og-source-placement",
    "data-og-preview-clone",
    "data-og-placement-generated",
    "data-og-slot-origin",
    "data-og-preview-locale",
    "data-og-preview-dir",
    "data-og-runtime-fallback-html",
    "contenteditable",
    "spellcheck"
  ],
  "cssVariables": [
    { "name": "--og-page-background", "category": "theme", "syntax": "<color>", "editable": true },
    { "name": "--og-text-color", "category": "theme", "syntax": "<color>", "editable": true },
    { "name": "--og-muted-color", "category": "theme", "syntax": "<color>", "editable": true },
    { "name": "--og-accent", "category": "theme", "syntax": "<color>", "editable": true },
    { "name": "--og-accent-foreground", "category": "theme", "syntax": "<color>", "editable": true },
    { "name": "width", "category": "box", "syntax": "<length-percentage>|auto|min()|max()|clamp()", "editable": true },
    { "name": "height", "category": "box", "syntax": "<length-percentage>|auto|min()|max()|clamp()", "editable": true },
    { "name": "min-width", "category": "box", "syntax": "<length-percentage>|auto|min()|max()|clamp()", "editable": true },
    { "name": "min-height", "category": "box", "syntax": "<length-percentage>|auto|min()|max()|clamp()", "editable": true },
    { "name": "max-width", "category": "box", "syntax": "<length-percentage>|none|min()|max()|clamp()", "editable": true },
    { "name": "flex", "category": "layout", "syntax": "<flex-shorthand>", "editable": true },
    { "name": "margin", "category": "layout", "syntax": "<box-shorthand>", "editable": true },
    { "name": "padding", "category": "layout", "syntax": "<box-shorthand>", "editable": true },
    { "name": "gap", "category": "layout", "syntax": "<length-percentage>{1,2}", "editable": true },
    { "name": "align-items", "category": "layout", "syntax": "<align-items>", "editable": true },
    { "name": "justify-content", "category": "layout", "syntax": "<justify-content>", "editable": true },
    { "name": "position", "category": "position", "syntax": "static|relative|absolute|fixed|sticky", "editable": true },
    { "name": "left", "category": "position", "syntax": "<length-percentage>|auto|min()|max()|clamp()", "editable": true },
    { "name": "top", "category": "position", "syntax": "<length-percentage>|auto|min()|max()|clamp()", "editable": true },
    { "name": "right", "category": "position", "syntax": "<length-percentage>|auto|min()|max()|clamp()", "editable": true },
    { "name": "bottom", "category": "position", "syntax": "<length-percentage>|auto|min()|max()|clamp()", "editable": true },
    { "name": "z-index", "category": "position", "syntax": "<integer>|auto", "editable": true },
    { "name": "color", "category": "appearance", "syntax": "<color>", "editable": true },
    { "name": "background", "category": "appearance", "syntax": "<color>|<image>|linear-gradient()", "editable": true },
    { "name": "border", "category": "appearance", "syntax": "<border-shorthand>", "editable": true },
    { "name": "border-radius", "category": "appearance", "syntax": "<box-shorthand>", "editable": true },
    { "name": "box-shadow", "category": "appearance", "syntax": "<box-shadow>", "editable": true },
    { "name": "font-family", "category": "text", "syntax": "<font-family-list>|var()", "editable": true },
    { "name": "--og-font-family-default", "category": "text", "syntax": "<font-family-list>|var()", "editable": true },
    { "name": "--og-font-family-ja", "category": "text", "syntax": "<font-family-list>|var()", "editable": true },
    { "name": "--og-font-family-en", "category": "text", "syntax": "<font-family-list>|var()", "editable": true },
    { "name": "--og-font-family-eng", "category": "text", "syntax": "<font-family-list>|var()", "editable": true },
    { "name": "--og-active-font-family", "category": "runtime", "syntax": "<font-family-list>|var()", "editable": false },
    { "name": "font-size", "category": "text", "syntax": "<length-percentage>", "editable": true },
    { "name": "font-weight", "category": "text", "syntax": "<number>|<font-weight-keyword>", "editable": true },
    { "name": "line-height", "category": "text", "syntax": "<number>|<length-percentage>", "editable": true },
    { "name": "letter-spacing", "category": "text", "syntax": "<length>|normal", "editable": true },
    { "name": "text-align", "category": "text", "syntax": "<text-align>", "editable": true },
    { "name": "--og-object-fit", "category": "media", "syntax": "<object-fit>", "editable": true },
    { "name": "--og-stroke-width", "category": "icon", "syntax": "<number>|<length>", "editable": true },
    { "name": "--og-icon-url", "category": "icon", "syntax": "url()", "editable": false },
    { "name": "animation", "category": "animation", "syntax": "<animation-shorthand>", "editable": true },
    { "name": "animation-name", "category": "animation", "syntax": "<keyframes-name>#|none", "editable": true },
    { "name": "animation-duration", "category": "animation", "syntax": "<time>#|auto", "editable": true },
    { "name": "animation-delay", "category": "animation", "syntax": "<time>#", "editable": true },
    { "name": "animation-timing-function", "category": "animation", "syntax": "<easing-function>#", "editable": true },
    { "name": "animation-iteration-count", "category": "animation", "syntax": "<number>|infinite", "editable": true },
    { "name": "animation-direction", "category": "animation", "syntax": "normal|reverse|alternate|alternate-reverse", "editable": true },
    { "name": "animation-fill-mode", "category": "animation", "syntax": "none|forwards|backwards|both", "editable": true },
    { "name": "animation-play-state", "category": "animation", "syntax": "running|paused", "editable": true },
    { "name": "animation-timeline", "category": "scroll-animation", "syntax": "auto|none|<dashed-ident>|scroll()|view()", "editable": true },
    { "name": "animation-range", "category": "scroll-animation", "syntax": "<animation-range-start> <animation-range-end>?", "editable": true },
    { "name": "animation-range-start", "category": "scroll-animation", "syntax": "normal|<timeline-range-name>? <length-percentage>", "editable": true },
    { "name": "animation-range-end", "category": "scroll-animation", "syntax": "normal|<timeline-range-name>? <length-percentage>", "editable": true },
    { "name": "timeline-scope", "category": "scroll-animation", "syntax": "none|all|<dashed-ident>#", "editable": true },
    { "name": "scroll-timeline", "category": "scroll-animation", "syntax": "<scroll-timeline-name> <scroll-timeline-axis>?", "editable": true },
    { "name": "scroll-timeline-name", "category": "scroll-animation", "syntax": "none|<dashed-ident>#", "editable": true },
    { "name": "scroll-timeline-axis", "category": "scroll-animation", "syntax": "block|inline|x|y", "editable": true },
    { "name": "view-timeline", "category": "scroll-animation", "syntax": "<view-timeline-name> <view-timeline-axis>?", "editable": true },
    { "name": "view-timeline-name", "category": "scroll-animation", "syntax": "none|<dashed-ident>#", "editable": true },
    { "name": "view-timeline-axis", "category": "scroll-animation", "syntax": "block|inline|x|y", "editable": true },
    { "name": "view-timeline-inset", "category": "scroll-animation", "syntax": "auto|<length-percentage>{1,2}", "editable": true },
    { "name": "--og-scale-x", "category": "transform", "syntax": "<number>", "editable": true },
    { "name": "--og-scale-y", "category": "transform", "syntax": "<number>", "editable": true },
    { "name": "transform-origin", "category": "transform", "syntax": "<position>", "editable": true },
    { "name": "--og-edit-width", "category": "runtime", "syntax": "<length-percentage>|auto", "editable": false },
    { "name": "--og-edit-min-height", "category": "runtime", "syntax": "<length-percentage>", "editable": false }
  ],
  "cssVariablePatterns": [
    { "pattern": "^--og-font-family-[a-z0-9]+(?:-[a-z0-9]+)*$", "category": "text", "syntax": "<font-family-list>|var()", "editable": true }
  ],
  "designTokens": {
    "selector": ":root",
    "namePattern": "^--[A-Za-z_][A-Za-z0-9_-]*$",
    "valueSyntax": "<declaration-value>"
  }
}
